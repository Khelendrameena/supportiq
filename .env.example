# Copy to .env and fill in. NEVER commit a real .env with secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: leave empty for local SQLite, or set for Postgres:
# DATABASE_URL=postgres://supportiq:supportiq@localhost:5432/supportiq
DATABASE_URL=

# Redis (Celery broker + cache). Leave empty for local in-memory fallback.
REDIS_URL=redis://localhost:6379/0

# LLM provider: "fake" (default, deterministic, no network) or "gemini"
LLM_BACKEND=fake
# GEMINI_API_KEY=   # required only when LLM_BACKEND=gemini
GEMINI_MODEL=gemini-2.0-flash

# Embeddings: "deterministic" (default, no network) or "sentence-transformers"
EMBEDDING_BACKEND=deterministic
EMBEDDING_DIM=384

# Reranker: "heuristic" (default) or "cross-encoder" (needs sentence-transformers)
RERANKER_BACKEND=heuristic

# Retrieval tuning
ABSTAIN_THRESHOLD=0.35
ABSTAIN_SEMANTIC_ONLY_THRESHOLD=0.55
RETRIEVAL_TOP_K=5

# Rate limits (requests per minute)
RATE_LIMIT_PER_USER=30
RATE_LIMIT_PER_TENANT=300

# Token budget per tenant per calendar month (rough token estimate)
TOKEN_BUDGET_PER_TENANT=1000000

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# Frontend -> API base URL (used by docker-compose frontend build)
VITE_API_URL=http://localhost:8000
